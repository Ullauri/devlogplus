# =============================================================================
# DevLog+ Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://devlogplus:devlogplus@db:5432/devlogplus

# --- OpenRouter (LLM API) ---------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Langfuse (LLM Observability) -------------------------------------------
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# --- LLM Model Selection Per Pipeline ---------------------------------------
# Each pipeline can use a different model via OpenRouter.
# Format: <provider>/<model-name>
LLM_MODEL_TOPIC_EXTRACTION=anthropic/claude-sonnet-5
LLM_MODEL_PROFILE_UPDATE=anthropic/claude-sonnet-5
LLM_MODEL_QUIZ_GENERATION=anthropic/claude-sonnet-5
LLM_MODEL_QUIZ_EVALUATION=anthropic/claude-sonnet-5
LLM_MODEL_READING_GENERATION=anthropic/claude-sonnet-5
LLM_MODEL_PROJECT_GENERATION=anthropic/claude-sonnet-5
LLM_MODEL_PROJECT_EVALUATION=anthropic/claude-sonnet-5

# Reasoning budget. Newer models reason by default, and OpenRouter bills
# reasoning as output tokens — so it draws down the same max_tokens the answer
# needs. Left unbounded, a pipeline can spend its whole budget thinking and
# return no content at all. "none" matches what this app's prompts and
# per-pipeline max_tokens were sized for; raise it deliberately, and raise the
# affected pipeline's max_tokens at the same time.
# Valid: none | minimal | low | medium | high | xhigh | max
LLM_REASONING_EFFORT=none

# --- Toolchain ---------------------------------------------------------------
# Path to the Go binary used for the post-generation compile check. The default
# is /usr/local/go/bin/go — the official-tarball layout — which does not exist
# on a Homebrew install. Point this at `which go` on your machine.
#
# With no Go toolchain the compile check is *skipped*, not failed: projects are
# still issued, but unverified, and run metadata records
# compile_check_skipped=true so that is visible rather than silent.
GO_EXECUTABLE=/opt/homebrew/bin/go

# --- Application Settings ---------------------------------------------------
QUIZ_QUESTION_COUNT=10
READING_RECOMMENDATION_COUNT=5
# If true, reading pipeline probes each LLM-proposed URL (HEAD/GET) and drops
# recommendations that don't resolve (2xx/3xx). Disable for offline dev.
READING_VALIDATE_URLS=true
READING_URL_VALIDATION_TIMEOUT=5.0
APP_ENV=development
LOG_LEVEL=INFO
